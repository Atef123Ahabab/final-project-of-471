              "raw": "{\n  \"employerId\": \"employer-001\",\n  \"jobTitle\": \"Senior Full-Stack Developer\",\n  \"description\": \"Looking for an experienced full-stack developer with expertise in Node.js and React. Must have at least 4 years of experience in web development.\",\n  \"requiredSkills\": [\"JavaScript\", \"Node.js\", \"React\", \"MongoDB\", \"Express\"],\n  \"qualifications\": [\n    \"Bachelor's degree in Computer Science or related field\",\n    \"4+ years of professional development experience\",\n    \"Experience with REST APIs\"\n  ],\n  \"location\": \"San Francisco, CA\",\n  \"salary\": {\n    \"min\": 120000,\n    \"max\": 180000,\n    \"currency\": \"USD\"\n  },\n  \"jobType\": \"Full-Time\",\n  \"experience\": {\n    \"min\": 4,\n    \"max\": 8\n  },\n  \"deadline\": \"2024-04-30\"\n}\n"
            },
            "url": {
              "raw": "http://localhost:1008/api/jobs/create",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1008",
              "path": ["api", "jobs", "create"]

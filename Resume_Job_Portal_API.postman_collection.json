                {
                  "key": "resume",
                  "type": "file",
                  "src": "sample_resume.pdf"
                },
                {
                  "key": "userId",
                  "value": "user-001",
                  "type": "text"
                },
                {
                  "key": "fullName",
                  "value": "John Doe",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "john@example.com",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "+1-555-0123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:1008/api/resumes/upload",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1008",
              "path": ["api", "resumes", "upload"]
            }
          },
          "response": []
        },
        {
          "name": "1.2 Parse Resume (Extract Skills & Experience)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": [\"JavaScript\", \"Node.js\", \"MongoDB\", \"React\"],\n  \"experience\": [\n    {\n      \"jobTitle\": \"Senior Software Engineer\",\n      \"company\": \"Tech Company ABC\",\n      \"duration\": \"2 years\",\n      \"description\": \"Developed RESTful APIs and managed database\"\n    },\n    {\n      \"jobTitle\": \"Junior Developer\",\n      \"company\": \"Startup XYZ\",\n      \"duration\": \"1.5 years\",\n      \"description\": \"Worked on frontend development\"\n    }\n  ],\n  \"education\": [\n    {\n      \"degree\": \"Bachelor of Science\",\n      \"institution\": \"University of Technology\",\n      \"year\": \"2020\"\n    }\n  ],\n  \"summary\": \"Experienced full-stack developer with expertise in Node.js and MongoDB\"\n}\n"
            },
            "url": {
              "raw": "http://localhost:1008/api/resumes/{{resumeId}}/parse",
              "protocol": "http",
              "host": ["localhost"],
              "port": "1008",
              "path": ["api", "resumes", "{{resumeId}}", "parse"]
            }
          },
          "response": []
        },

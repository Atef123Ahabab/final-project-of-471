# Copy this file to .env and fill values before running locally or deploying
MONGODB_URI=mongodb+srv://<dbUser>:<dbPassword>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
RESEND_API_KEY=
SENDGRID_API_KEY=
FRONTEND_URL=https://your-frontend-url.onrender.com
NODE_ENV=production
# Optional
HOST=0.0.0.0
PORT=1008